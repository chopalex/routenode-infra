[Unit]
Description=Pi-hole DNS relay for worker node only (53 -> Pi-hole)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat UDP4-LISTEN:53,bind=PUBLIC_IP,fork,reuseaddr UDP4:172.29.172.10:53
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
