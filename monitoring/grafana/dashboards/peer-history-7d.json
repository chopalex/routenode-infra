{
  "id": null,
  "uid": "routenode-peer-7d",
  "title": "AmneziaWG / Peer history 7d",
  "description": "Weekly view for SLA discussions: uptime bands, traffic totals, availability per peer",
  "tags": [
    "routenode",
    "awg",
    "sla"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "peer",
        "label": "Peer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(last_over_time(awg_peer_info[2m]))",
          "refId": "q"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "definition": "query_result(last_over_time(awg_peer_info[2m]))",
        "regex": "/friendly_name=\"([^\\\"]+)\"/"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "routenode"
      ],
      "targetBlank": false,
      "title": "Navigation",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "type": "table",
      "id": 1,
      "title": "Availability & traffic, 7 days",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Availability 7d",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "expr": "avg by (peer) (avg_over_time(awg_peer_online[7d])) * on (peer) group_left (friendly_name) last_over_time(awg_peer_info[2m])",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "max by (peer) (awg_peer_receive_bytes_total) * on (peer) group_left (friendly_name) last_over_time(awg_peer_info[2m])",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "avg by (peer) (slo:peer_availability_24h) * on (peer) group_left (friendly_name) last_over_time(awg_peer_info[2m])",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "max by (peer) (awg_peer_transmit_bytes_total) * on (peer) group_left (friendly_name) last_over_time(awg_peer_info[2m])",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "peer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "job": true,
              "instance": true,
              "host": true,
              "Value #C": true,
              "friendly_name 1": true,
              "friendly_name 2": true,
              "friendly_name 3": true,
              "allowed_ips": true,
              "allowed_ips 1": true,
              "allowed_ips 2": true,
              "allowed_ips 3": true,
              "public_key": true,
              "public_key 1": true,
              "public_key 2": true,
              "public_key 3": true,
              "peer 1": true,
              "peer 2": true,
              "peer 3": true,
              "peer 4": true,
              "endpoint": true,
              "endpoint_ip": true,
              "country": true,
              "city": true,
              "isp": true,
              "geo": true
            },
            "renameByName": {
              "friendly_name": "Client",
              "Value #A": "Availability 7d",
              "Value #B": "Downloaded 7d",
              "Value #D": "Uploaded 7d",
              "peer": "IP"
            },
            "indexByName": {
              "Client": 0,
              "IP": 1,
              "Availability 7d": 2,
              "Downloaded 7d": 3,
              "Uploaded 7d": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Client"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Availability 7d"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#e02d5c",
                      "value": null
                    },
                    {
                      "color": "rgb(217,119,6)",
                      "value": 0.9
                    },
                    {
                      "color": "#4f8df9",
                      "value": 0.98
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Downloaded 7d"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uploaded 7d"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IP"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Online/offline bands, 7d",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "awg_peer_online{friendly_name=~\"$peer\"}",
          "legendFormat": "{{friendly_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Daily traffic (download, stacked)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (friendly_name) (avg_over_time(awg:peer_rx_bps{friendly_name=~\"$peer\"}[1h]))",
          "legendFormat": "{{friendly_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Daily traffic (upload, stacked)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (friendly_name) (avg_over_time(awg:peer_tx_bps{friendly_name=~\"$peer\"}[1h]))",
          "legendFormat": "{{friendly_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Handshake age 7d (spikes = reconnects)",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4f8df9",
                "value": null
              },
              {
                "color": "rgb(217,119,6)",
                "value": 180
              },
              {
                "color": "#e02d5c",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "awg_peer_handshake_age_seconds{friendly_name=~\"$peer\"}",
          "legendFormat": "{{friendly_name}}",
          "refId": "A"
        },
        {
          "expr": "vector(900)",
          "legendFormat": "stale threshold",
          "refId": "B"
        }
      ]
    }
  ],
  "preferences": {}
}
