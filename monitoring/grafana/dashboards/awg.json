    {
      "type": "table",
      "id": 20,
      "title": "Clients",
      "description": "Names from Amnezia clientsTable; GeoIP from peer public endpoint",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Status",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (peer) (awg_peer_online)",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (peer) (awg_peer_handshake_age_seconds)",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum by (peer) (awg_peer_receive_bytes_total)",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "sum by (peer) (awg_peer_transmit_bytes_total)",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "sum by (peer, friendly_name, country, city, isp) (awg_peer_info)",
          "format": "table",
          "instant": true,
          "refId": "E"
        }
      ],
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "peer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "__name__ 5": true,
              "job": true,
              "instance": true,
              "host": true,
              "Value #E": true,
              "geo": true,
              "endpoint": true,
              "endpoint_ip": true
            },
            "renameByName": {
              "friendly_name": "Client",
              "Value #A": "Status",
              "Value #B": "Last seen",
              "Value #C": "Upload",
              "Value #D": "Download",
              "peer": "ip",
              "city": "City",
              "country": "CC",
              "isp": "ISP"
            },
            "indexByName": {
              "Client": 0,
              "Status": 1,
              "Last seen": 2,
              "Upload": 3,
              "Download": 4,
              "ip": 5,
              "City": 6,
              "CC": 7,
              "ISP": 8
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Client"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "off",
                        "color": "rgb(148, 163, 184)"
                      },
                      "1": {
                        "text": "on",
                        "color": "rgb(22, 163, 74)"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "never"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Upload"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
