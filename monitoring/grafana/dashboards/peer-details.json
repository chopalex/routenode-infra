          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "expr": "sum by (peer) (awg_peer_transmit_bytes_total)",
          "format": "table",
          "instant": true,
          "refId": "F"
        },
        {
          "expr": "sum by (peer, friendly_name, country, city, isp) (awg_peer_info)",
          "format": "table",
          "instant": true,
          "refId": "G"
        },
        {
          "expr": "sum by (peer) (awg_peer_handshake_unixtime)",
          "format": "table",
          "instant": true,
          "refId": "H"
