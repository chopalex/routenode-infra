    {
      "type": "table",
      "id": 20,
      "title": "Services",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "rgb(220, 38, 38)"
                      },
                      "1": {
                        "text": "UP",
                        "color": "rgb(22, 163, 74)"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cpu %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "container_service_up",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "docker_container_memory_bytes",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "docker_container_cpu_percent",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "docker_container_pids",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
