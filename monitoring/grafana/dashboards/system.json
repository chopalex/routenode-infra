{
  "annotations": {
    "list": []
  },
  "description": "Host + container capacity",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "routenode"
      ],
      "targetBlank": false,
      "title": "Navigation",
      "type": "dashboards"
